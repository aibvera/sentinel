# Copia este archivo como .env y ajusta los valores. Lo leen el recorder, la api y docker compose.
# (Sin comillas ni comentarios al final de línea: así lo entienden tanto python-dotenv como Docker.)

# ===== Recorder (grabación por movimiento) =====

# --- Cámara ---
RTSP_URL=rtsp://usuario:clave@192.168.1.XX:XXX/stream1
# tcp es más estable; udp tiene menos latencia
RTSP_TRANSPORT=tcp

# --- Detección de movimiento ---
# % de píxeles distintos al frame anterior para considerar que hay movimiento
DISIMIL_TH=0.5
# Diferencia de intensidad (0-255) para considerar que un píxel cambió
PIXEL_DIFF_TH=25

# --- Grabación ---
# Carpeta de videos para ejecución local, relativa a la raíz del repo (en Docker es /recordings)
SAVE_PATH=recordings
# Segundos grabados antes y después del movimiento
PRE_RECORD_SECONDS=2
POST_RECORD_SECONDS=5
# Duración máxima de un clip; los eventos largos se parten en varios archivos
MAX_CLIP_SECONDS=300
# Calidad H.264: menor CRF = más calidad y más peso (18-30 razonable)
VIDEO_CRF=26
VIDEO_PRESET=veryfast

# --- Almacenamiento ---
# Días que se conservan los videos antes de borrarse automáticamente
ELIMINATION_DAYS=7
# Si el disco baja de este espacio libre, se borran los videos más antiguos (0 = desactivado)
MIN_FREE_MB=1024
CLEANUP_INTERVAL_MINUTES=10

# --- Sistema ---
# Zona horaria de carpetas, archivos y logs del recorder y la api (vacío = hora local del sistema)
TIMEZONE=America/Bogota
LOG_LEVEL=INFO

# --- PARA TELEGRAM ---
# Aviso al celular si la cámara no entrega imagen durante TELEGRAM_ALERT_MINUTES (y otro cuando vuelve).
# Deja el token y el chat id vacíos para desactivar las alertas.
# Token que entrega @BotFather al crear el bot
TELEGRAM_BOT_TOKEN=
# Id numérico de tu chat con el bot (ver README)
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_MINUTES=5

# ===== Sentinel (docker compose y api) =====

# --- Carpetas del host (bind mounts) ---
# Videos que graba el recorder; la api los lee en solo lectura
HOST_RECORDINGS=./recordings
# Base SQLite (sentinel.db), recortes de rostros y miniaturas
HOST_DATA=./data
# Solo Linux: dueño de los archivos creados (id -u / id -g)
HOST_UID=1000
HOST_GID=1000

# --- Puertos ---
WEB_PORT=8080
API_PORT=8000

# --- Detección ---
# Frames analizados por segundo de video
SAMPLE_FPS=2
# Confianza mínima (0-1) para aceptar una persona y un rostro
PERSON_CONF=0.45
FACE_CONF=0.75
# Por cada ventana de estos segundos se guardan los rostros de un solo frame (el más claro)
FACE_INTERVAL_SECONDS=2

# --- Recursos ---
# Hilos de inferencia y núcleos máximos del contenedor api
ORT_THREADS=4
API_CPUS=4

# --- Worker ---
# Cada cuánto se revisa la carpeta de videos
SCAN_SECONDS=5
# Un clip se analiza cuando lleva este tiempo sin modificarse (ya terminó de grabarse)
STABLE_SECONDS=15
